# act configuration for local GitHub Actions testing
# Ref: https://nektosact.com/

# Map the self-hosted macOS runner labels to run natively (no Docker)
-P self-hosted=-self-hosted
-P macOS=-self-hosted
-P ARM64=-self-hosted

# Use catthehacker's image for ubuntu-latest / blacksmith jobs (blacksmith
# runners aren't available locally; falls back to a plain Ubuntu container)
-P ubuntu-latest=catthehacker/ubuntu:act-latest
-P blacksmith-4vcpu-ubuntu-2404=catthehacker/ubuntu:act-latest

# Match host architecture (Apple Silicon)
--container-architecture=linux/arm64

# Reuse containers for faster subsequent runs
--reuse
