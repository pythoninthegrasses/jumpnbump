# Build artifacts
*.o
*.a
*.exe

# Generated by top-level Makefile
/globals.h
/jnbmenu.tcl

# Built binaries
/jumpnbump
/gobpack
/jnbpack
/jnbunpack

# Packed game data
/data/*.gob
/data/jumpbump.dat

# Docs generated from man page
/jumpnbump.html

# Misc runtime/debug artifacts (from .cvsignore)
jnb.tmpmusic.mod
stdout.txt
stderr.txt

# Zig build artifacts
.zig-cache/
zig-out/

# SwiftPM build artifacts (screensaver/, TASK-017.03)
screensaver/.build/

# SCons/GDExtension build artifacts (extension/, TASK-012.04/TASK-012.05).
# game/bin/*.gdextension is checked in (it's config, not a build output).
*.os
extension/.sconsign.dblite
extension/.sconf_temp/
/game/bin/*.so
/game/bin/*.dylib
/game/bin/*.dll
/game/bin/*.wasm
/game/bin/*.framework/

# Taskfile-managed local cache (zig cache dir, macOS CI's SDL 1.2 source build)
/.cache/

# go-task's own checksum cache for sources/generates freshness checks
/.task/

# tools/bootstrap.py's checksum-verified downloads (TASK-014.07)
/.tools/

# gdUnit4 (TASK-014.07) -- checksum-verified download, not vendored
/game/addons/gdUnit4/

# gdUnit4's generated HTML/XML test reports (TASK-014.07)
/game/reports/

# Godot editor import cache (game/, TASK-014.01) -- regenerated on first open;
# *.import sidecar files and *.uid files next to source assets/scripts are
# real, stable metadata and stay committed, matching neo_snake's convention.
/game/.godot/

# Agent config
CLAUDE.md

# tools/capture_level_picker.sh's screenshots (TASK-016.02 follow-up,
# judgment-matched visual verification, not committed test fixtures)
/artifacts/

# Godot export output (TASK-009, task release:ship-macos)
/game/build/

# Signing/notarization secrets (TASK-009) -- never committed, see .env.example
.env
